MONGODB_URI=mongodb://127.0.0.1:27017/z
PORT=3001
NODE_ENV=development
PAYMENT_MODE=mock
MOCK_PAYMENTS_ENABLED=true
# Only enable this for a Render/staging test deployment; mock payments do not charge money.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=true
PLATFORM_COMMISSION_RATE=0.10
ORDER_RESERVATION_MINUTES=15
PAYOUT_HOLD_HOURS=72
# Defaults to PAYOUT_HOLD_HOURS; the second delay runs after the ready stage.
PAYOUT_PROCESSING_HOURS=72
PAYOUT_SWEEP_SECONDS=1
SIMULATE_PAYOUTS=true
# The configured owner email is not sufficient by itself; also set the matching user ID.
ADMIN_EMAIL=z@gmail.com
ADMIN_USER_ID=
# Sandbox accounts are development-only and require a loopback MongoDB URI.
SANDBOX_EMAIL=sandbox@z.com
# Local development URL. Render deployments use their public URL automatically; set this to a custom HTTPS domain if needed.
APP_BASE_URL=http://192.168.188.157:3001
# Set to the exact number of trusted reverse proxies in front of this server.
TRUST_PROXY_HOPS=0
GEOIP_CITY_DATABASE_PATH=
GEOIP_ASN_DATABASE_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Configure a signed preset restricted to jpg/png/webp and enable EXIF metadata stripping.
# The server enforces the 5 MB image upload limit.
CLOUDINARY_UPLOAD_PRESET=
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen3.5:4b
AI_REQUEST_TIMEOUT_MS=90000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KYC_ENCRYPTION_KEY=
KYC_STORAGE_DURABLE=false